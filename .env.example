DATABASE_URL=postgres://user:password@host:5432/called

NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_RPC_URL=

# Ed25519 seed, 32 bytes as hex or base64. Generate: openssl rand -hex 32
# Public key is served at /.well-known/called-receipt-key
RECEIPT_SIGNING_KEY=
# Robinhood Chain wallet private key, used to send zero-value anchor txs.
# Generate a fresh key with `npm run gen:env`, then fund it from a faucet.
ANCHOR_PRIVATE_KEY=
# PBKDF2 input for AES-256-GCM payload encryption. Generate: openssl rand -base64 32
PAYLOAD_ENCRYPTION_KEY=
OPENROUTER_API_KEY=

HOUSE_TEMPERATURE=0
# Comma-separated wallet addresses allowed to use /admin. Lowercased on compare.
ADMIN_WALLETS=
# Bearer token for the cron routes. Generate: openssl rand -hex 32
CRON_SECRET=
# Derives session tokens. Generate: openssl rand -hex 32
SESSION_SECRET=
